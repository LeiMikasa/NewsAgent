# mock 可离线运行；anthropic / deepseek 使用 Anthropic Messages 兼容接口。
AGENT_PROVIDER=mock
MODEL_ID=mock-1

# 使用真实模型时，修改 provider、model 并填写自己的 key。
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
# DeepSeek 兼容端点示例：https://api.deepseek.com/anthropic

# 新闻搜索 / 网页正文提取，独立于模型 API Key。未填写时工具返回配置错误。
TAVILY_API_KEY=
# 单次 HTTP 请求的 socket 超时（秒），最多 120；重试由 Runtime 统一管理。
TAVILY_TIMEOUT=30

AGENT_MAX_TURNS=30
# 首次执行之后最多自动重试 2 次（仅限显式允许的只读临时故障）；0 关闭。
AGENT_MAX_TOOL_RETRIES=2
# 首次可修正失败之后最多再给模型 2 次修正机会；成功清零，每次请求重建预算。
AGENT_MAX_TOOL_REPAIRS=2
AGENT_MAX_TOKENS=4096
AGENT_MODEL_TIMEOUT=120
AGENT_BASH_TIMEOUT=30
AGENT_MAX_TOOL_OUTPUT=20000
# auto 优先找 bash；Windows 找不到则使用 PowerShell，POSIX 则使用 sh。
AGENT_SHELL=auto
# 文件工具限于 workdir；bash 是宿主 shell，并不是沙箱。
AGENT_ALLOW_BASH=true
# AGENT_WORKDIR=D:/NewsAgent

# 长期记忆：首次交互收集身份和偏好，以 Markdown 保存到自己的工作区。
AGENT_MEMORY_ENABLED=true
# false 时保留资料加载与手动更新，关闭普通对话结束后的自动提取。
AGENT_MEMORY_AUTO_EXTRACT=true
# 相对工作区，必须位于工作区子目录；默认 .agent/memory。
# AGENT_MEMORY_DIR=.agent/memory

# 简报归档目录，必须位于工作区子目录，不能与记忆目录重叠。
# --brief / 交互命令 /brief 生成后保存，普通对话不自动归档。
# AGENT_BRIEFS_DIR=.agent/briefs
